# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
# auto = JSON lines when APP_ENV=production, readable text otherwise; or force text / json
LOG_FORMAT=auto
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
OWNER_EMAILS=owner@example.com

# Supabase "Session pooler" connection string (IPv4-friendly), e.g.
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=product-images

# Where the mobile app may be sent after Google sign-in (comma-separated link prefixes).
# Add exp:// ONLY while testing in Expo Go; remove it for real builds.
MOBILE_REDIRECT_PREFIXES=isabella://

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=
